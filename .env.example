# ============================================================
# MSW 街健館 — 環境變數
# 複製本檔為 .env.local 並填入你的 Supabase 專案資訊
# ============================================================

# Supabase 專案 URL
# 取得位置：Supabase 後台 → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase anon public key（可公開於前端，受 RLS 保護）
# 取得位置：Supabase 後台 → Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 網站網址（用於電郵驗證連結導回）
# 本機開發填 http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
